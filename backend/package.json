{
  "name": "backend",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "dev": "cross-env NODE_ENV=development tsx watch src/server.ts",
    "start": "cross-env NODE_ENV=production node dist/server.js",
    "build": "rimraf dist && tsc && tsc-alias",
    "lint": "eslint src/**/*.ts",
    "seed": "tsx src/scripts/seed.ts",
    "seed:admin:up": "tsx src/seeders/user.seeder.ts seed",
    "seed:admin:up:prod": "cross-env NODE_ENV=production tsx src/seeders/user.seeder.ts seed",
    "seed:admin:down": "tsx src/seeders/user.seeder.ts clear",
    "seed:criteria:up": "tsx src/seeders/criteria.seeder.ts up",
    "seed:criteria:up:prod": "cross-env NODE_ENV=production tsx src/seeders/criteria.seeder.ts up",
    "seed:criteria:down": "tsx src/seeders/criteria.seeder.ts down",
    "seed:laptop:up": "tsx src/seeders/laptop.seeder.ts up",
    "seed:laptop:up:prod": "cross-env NODE_ENV=production tsx src/seeders/laptop.seeder.ts up",
    "seed:laptop:down": "tsx src/seeders/laptop.seeder.ts down",
    "fix:laptop-scores": "tsx src/seeders/laptop-fix-scores.seeder.ts",
    "fix:laptop-scores:apply": "tsx src/seeders/laptop-fix-scores.seeder.ts --apply",
    "fix:laptop-scores:prod": "cross-env NODE_ENV=production tsx src/seeders/laptop-fix-scores.seeder.ts",
    "fix:laptop-scores:apply:prod": "cross-env NODE_ENV=production tsx src/seeders/laptop-fix-scores.seeder.ts --apply"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "sistem pendukung keputusan laptop bekas menggunakan SMART",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "joi": "^18.2.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.4.0",
    "morgan": "^1.11.0",
    "multer": "^2.1.1",
    "node-cron": "^4.2.1",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.1.0",
    "@types/node": "^20.14.2",
    "@types/node-cron": "^3.0.11",
    "cross-env": "^10.1.0",
    "rimraf": "^6.1.3",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.16",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.15.2",
    "typescript": "^5.4.5"
  }
}
